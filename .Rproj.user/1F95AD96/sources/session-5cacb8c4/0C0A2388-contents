           main="Top 10 Important Features")
```

# 7. Conclusion and Limitations

```{r conclusion, results='asis'}
best_model <- metrics$Model[which.max(metrics$Accuracy)]

cat("Based on the held-out test set, the model with the higher ",
    "accuracy is **", best_model, "**.\n\n", sep="")

cat("Decision Tree accuracy: ",
    round(metrics$Accuracy[1] * 100, 2), "%.\n\n", sep="")

cat("Random Forest accuracy: ",
    round(metrics$Accuracy[2] * 100, 2), "%.\n\n", sep="")

cat("The models were compared using accuracy, sensitivity, ",
    "specificity, and ROC-AUC. Results depend on the train-test ",
    "split and dataset.\n\n", sep="")

cat("**Limitations:** This is a small, publicly available dataset. ",
    "Performance on this dataset does not establish clinical safety ",
    "or suitability for diagnosing patients.\n", sep="")
```
